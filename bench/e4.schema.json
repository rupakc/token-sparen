{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rupakc/token-sparen/bench/e4.schema.json",
  "title": "token-sparen E4 benchmark evidence (e4.json)",
  "description": "Published by `python -m bench report --publish` (confirmation: docs/evidence/e4.json); read by the M6 release gate. Cross-field rules checked by bench.e4.validate_e4 beyond this schema: exactly one result with metric resolved_diff_pp and confirmatory true, which compares arm token-sparen to baseline baseline with margin_pp -5 and non_inferior == (ci95[0] > margin_pp); no other result is confirmatory; every result arm/baseline names a listed arm; arm names unique and include baseline and token-sparen; date.from <= date.to; ci95[0] <= ci95[1]; screening has power null, gate null or not passed, and style_rule not recommend_opt_in; confirmation has power and gate, and the gate carries plan_sha256, ledger_chain_head and grades_chain_head (the recorded plan's hash and the heads of the verified ledger and grades hash chains, anchored by the signed release commit); gate passed needs non_inferior and power powered; gate underpowered needs power underpowered. Free text is closed: exclusions[].reason and .cause, gate.reasons[] and report.disclosures[] are codes from the $defs enums (the report renders their prose from fixed templates). Additional fields are allowed (additive changes keep schema_version); removing or changing a field bumps it.",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "suite",
    "stage",
    "campaign",
    "n_tasks",
    "seeds",
    "model",
    "claude_code_version",
    "date",
    "plugin_version",
    "plugin_hash",
    "harness_commit",
    "script",
    "grader",
    "arms",
    "exclusions",
    "power",
    "results",
    "gate",
    "style_rule"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source": {"const": "E4"},
    "suite": {"type": "string", "pattern": "^swe-bench-verified-[a-z0-9-]+$"},
    "stage": {"enum": ["screening", "confirmation"]},
    "campaign": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "n_tasks": {"type": "integer", "minimum": 1},
    "seeds": {"type": "integer", "minimum": 1},
    "model": {"type": "string", "minLength": 1},
    "claude_code_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"},
    "date": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": {"type": "string", "format": "date"},
        "to": {"type": "string", "format": "date"}
      }
    },
    "plugin_version": {"type": "string", "minLength": 1},
    "plugin_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "harness_commit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "script": {"type": "string", "pattern": "(^|[\\s/])bench([\\s/]|$)"},
    "grader": {
      "type": "object",
      "required": ["name", "version", "arch"],
      "properties": {
        "name": {"const": "swebench"},
        "version": {"type": "string", "minLength": 1},
        "arch": {"enum": ["arm64", "amd64"]}
      }
    },
    "arms": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["name", "kind", "pin"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "kind": {"enum": ["baseline", "prompt", "plugin", "hook", "wrapper"]},
          "pin": {"type": ["string", "null"]}
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["instance_id", "reason"],
        "properties": {
          "instance_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
          "reason": {"$ref": "#/$defs/exclusion_reason"},
          "arm": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "seed": {"type": "integer", "minimum": 0},
          "cause": {"$ref": "#/$defs/exclusion_cause"}
        }
      }
    },
    "power": {
      "type": ["object", "null"],
      "required": ["required_tasks", "seeds", "achieved_power", "verdict"],
      "properties": {
        "required_tasks": {"type": ["integer", "null"], "minimum": 1},
        "seeds": {"type": "integer", "minimum": 1},
        "achieved_power": {"type": "number", "minimum": 0, "maximum": 1},
        "verdict": {"enum": ["powered", "underpowered"]}
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/result"}
    },
    "gate": {
      "type": ["object", "null"],
      "required": ["verdict", "reasons"],
      "properties": {
        "verdict": {"enum": ["passed", "failed", "underpowered"]},
        "reasons": {"type": "array", "items": {"$ref": "#/$defs/gate_reason"}},
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "ledger_chain_head": {"$ref": "#/$defs/sha256"},
        "grades_chain_head": {"$ref": "#/$defs/sha256"}
      }
    },
    "style_rule": {"enum": ["recommend_opt_in", "keep_off", "not_run"]},
    "report": {
      "type": "object",
      "properties": {
        "disclosures": {"type": "array", "items": {"$ref": "#/$defs/disclosure"}}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exclusion_reason": {
      "enum": [
        "run_unrunnable",
        "run_incomplete",
        "run_ungraded",
        "preflight_build",
        "preflight_gold_fail",
        "preflight_flaky_gold",
        "preflight_noop_pass",
        "preflight_harness_error"
      ]
    },
    "exclusion_cause": {
      "enum": [
        null,
        "auth",
        "api",
        "rate",
        "docker",
        "proxy",
        "load",
        "leak",
        "disk",
        "unknown",
        "harness_error",
        "no_grade"
      ]
    },
    "gate_reason": {
      "enum": [
        "plan_hash_not_release",
        "plugin_hash_mismatch",
        "frozen_run_without_hash",
        "treatment_not_live",
        "model_mismatch",
        "claude_code_version_mismatch",
        "e2_failed",
        "clearly_inferior",
        "underpowered_owner_decides",
        "lower_bound_not_above_margin",
        "too_few_paired_tasks",
        "one_sided_pending",
        "excess_exclusions_imputed",
        "outside_plan_ignored"
      ]
    },
    "disclosure": {
      "enum": [
        "labels",
        "network",
        "competitor_defaults",
        "tokeneconomizer_headless",
        "caveman_inert",
        "headroom_proxy",
        "platform"
      ]
    },
    "result": {
      "type": "object",
      "required": ["metric", "arm", "baseline", "estimate", "ci95", "n", "method", "confirmatory"],
      "properties": {
        "metric": {
          "type": "string",
          "pattern": "^(cost_ratio_median|resolved_rate|resolved_diff_pp|tokens_[a-z][a-z0-9_]*_median|turns_median|wall_s_median)$"
        },
        "arm": {"type": "string"},
        "baseline": {"type": ["string", "null"]},
        "estimate": {"type": "number"},
        "ci95": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number"}
        },
        "n": {"type": "integer", "minimum": 1},
        "method": {"type": "string", "minLength": 1},
        "confirmatory": {"type": "boolean"},
        "margin_pp": {"type": "number"},
        "non_inferior": {"type": "boolean"}
      }
    }
  }
}
